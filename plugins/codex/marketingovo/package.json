{
  "name": "@marketingovo/codex-plugin",
  "version": "1.1.0",
  "private": true,
  "description": "Installable Codex bundle for Marketingovo",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    ".codex-plugin",
    ".mcp.json",
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node --check scripts/build.mjs && node --check scripts/validate.mjs && node --check dist/marketingovo-mcp.mjs",
    "lint": "node --check scripts/build.mjs && node --check scripts/validate.mjs",
    "test": "node scripts/validate.mjs",
    "prepublishOnly": "node ../../../scripts/npm-publication-disabled.mjs direct-package-publish"
  },
  "dependencies": {
    "@marketingovo/mcp": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
