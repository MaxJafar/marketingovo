{
  "name": "agentintel-workspace",
  "version": "0.2.0-alpha.0",
  "private": true,
  "description": "Evidence-first local competitive and creator intelligence platform",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test --concurrency=2",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && pnpm lint:python && pnpm lint:go",
    "lint:python": "uv run --project workers/intelligence ruff check workers/intelligence",
    "lint:go": "go vet ./...",
    "test:go": "go test ./...",
    "test:python": "uv run --project workers/intelligence pytest workers/intelligence/tests",
    "plugins:generate": "node scripts/generate-agent-plugins.mjs",
    "validate:plugins": "node scripts/generate-agent-plugins.mjs --check && node scripts/validate-plugins.mjs",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:lint": "node scripts/validate-contracts.mjs",
    "contracts:breaking": "node scripts/check-proto-breaking.mjs",
    "validate:no-nested-checkout": "node scripts/validate-no-nested-checkout.mjs",
    "validate:identity": "node scripts/validate-identity.mjs",
    "reference:validate": "node scripts/reference-lab-validate.mjs",
    "reference:scan": "node scripts/scan-reference-secrets.mjs",
    "reference:scan:strict": "node scripts/scan-reference-secrets.mjs --fail-on-unquarantined",
    "check": "pnpm validate:no-nested-checkout && pnpm validate:identity && pnpm reference:validate && pnpm reference:scan:strict && pnpm contracts:lint && pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm test:go && pnpm test:python && pnpm validate:plugins",
    "intel:daemon": "go run ./cmd/agentinteld",
    "intel": "go run ./cmd/agentintel"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.9.0",
    "@types/node": "^24.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  }
}
