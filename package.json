{
  "name": "marketingovo-workspace",
  "version": "1.1.0",
  "private": true,
  "description": "Marketingovo monorepo",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3",
      "brace-expansion": ">=5.0.9",
      "fast-uri@3": "3.1.4",
      "fast-uri@4": ">=4.1.1",
      "find-my-way": ">=9.7.0",
      "js-yaml@4": "4.3.0",
      "postcss": ">=8.5.25"
    }
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test --concurrency=2 -- --maxWorkers=2",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:core": "pnpm --filter @marketingovo/core test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:no-containers": "node scripts/validate-no-containers.mjs",
    "validate:contracts": "node scripts/validate-contracts.mjs",
    "plugins:generate": "node scripts/generate-agent-plugins.mjs",
    "validate:plugins": "node scripts/generate-agent-plugins.mjs --check && node scripts/validate-plugins.mjs",
    "validate:licenses": "node scripts/validate-licenses.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "pack:smoke": "node scripts/package-smoke.mjs",
    "benchmark": "node --test benchmarks/corpus-metrics.test.mjs && node benchmarks/run.mjs",
    "desktop:prepare": "node scripts/prepare-desktop-runtime.mjs",
    "desktop:verify": "node scripts/verify-desktop-runtime.mjs",
    "desktop:configure-release": "node scripts/configure-desktop-release.mjs",
    "release:preflight": "node scripts/validate-release-environment.mjs",
    "release:verify": "node scripts/verify-release-artifacts.mjs",
    "release:test": "node --test scripts/release-policy.test.mjs scripts/updater-metadata-policy.test.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "release:updater-metadata": "node scripts/create-updater-metadata.mjs",
    "npm:prepare-release": "node scripts/npm-publication-disabled.mjs npm:prepare-release",
    "npm:publish-release": "node scripts/npm-publication-disabled.mjs npm:publish-release",
    "npm:release-test": "node --test scripts/npm-release-policy.test.mjs scripts/public-release-policy.test.mjs",
    "prepublishOnly": "node scripts/npm-publication-disabled.mjs direct-package-publish",
    "identity:check": "node scripts/identity-migration-policy.mjs",
    "identity:test": "node --test scripts/identity-migration-policy.test.mjs",
    "check": "pnpm format:check && pnpm validate:no-containers && pnpm validate:no-nested-checkout && pnpm reference:validate && pnpm reference:scan:strict && pnpm identity:check && pnpm identity:test && pnpm build && pnpm lint && pnpm typecheck && pnpm test && pnpm release:test && pnpm npm:release-test && pnpm benchmark && pnpm validate:contracts && pnpm validate:plugins && pnpm validate:skills && pnpm validate:licenses && pnpm pack:smoke",
    "clean": "turbo run clean",
    "marketingovo": "node packages/cli/dist/cli.js",
    "validate:skills": "node scripts/validate-skill-discipline.mjs",
    "validate:no-nested-checkout": "node scripts/validate-no-nested-checkout.mjs",
    "build:go": "go -C services/intel-daemon build ./...",
    "lint:go": "go -C services/intel-daemon vet ./...",
    "test:go": "go -C services/intel-daemon test ./...",
    "test:go:race": "go -C services/intel-daemon test -race ./...",
    "lint:python": "uv run --project services/intelligence-worker ruff check services/intelligence-worker",
    "test:python": "uv run --project services/intelligence-worker pytest services/intelligence-worker/tests",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:breaking": "node scripts/check-proto-breaking.mjs",
    "reference:validate": "node scripts/reference-lab-validate.mjs",
    "reference:scan": "node scripts/scan-reference-secrets.mjs",
    "reference:scan:strict": "node scripts/scan-reference-secrets.mjs --fail-on-unquarantined",
    "intel": "go -C services/intel-daemon run ./cmd/agentintel",
    "intel:daemon": "go -C services/intel-daemon run ./cmd/agentinteld",
    "check:native": "pnpm build:go && pnpm lint:go && pnpm test:go && pnpm lint:python && pnpm test:python",
    "check:all": "pnpm check && pnpm check:native"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.3.0",
    "axe-core": "4.12.1",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
