{
  "name": "agentseo",
  "version": "0.11.0-alpha.0",
  "description": "CLI and local service launcher for AGENTseo",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agentseo": "./dist/cli.js"
  },
  "files": [
    "dist",
    "dashboard",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-dashboard.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx src/cli.ts serve",
    "prepublishOnly": "node ../../scripts/npm-publication-disabled.mjs direct-package-publish"
  },
  "dependencies": {
    "@agentseoapp/contracts": "workspace:*",
    "@agentseoapp/credentials": "workspace:*",
    "@agentseoapp/legacy-import": "workspace:*",
    "@agentseoapp/runtime": "workspace:*",
    "@agentseoapp/sdk": "workspace:*",
    "@agentseoapp/server": "workspace:*",
    "@agentseoapp/storage-sqlite": "workspace:*"
  },
  "devDependencies": {
    "@agentseoapp/dashboard": "workspace:*",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "private": true
}
