{
  "name": "@agentseoapp/sdk",
  "version": "0.11.0-alpha.0",
  "description": "Typed client for the AGENTseo local REST API",
  "license": "Elastic-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "generate": "node scripts/generate-openapi-types.mjs",
    "generate:check": "node scripts/generate-openapi-types.mjs --check",
    "build": "pnpm generate:check && tsc -p tsconfig.json",
    "typecheck": "pnpm generate:check && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm generate:check && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "node ../../scripts/npm-publication-disabled.mjs direct-package-publish"
  },
  "dependencies": {
    "@agentseoapp/contracts": "workspace:*",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@agentseoapp/server": "workspace:*",
    "@types/node": "^26.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "private": true
}
