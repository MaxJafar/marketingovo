{
  "name": "@marketingovo/sdk",
  "version": "1.1.0",
  "description": "Typed client for the Marketingovo local REST API",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "generate": "node scripts/generate-openapi-types.mjs",
    "generate:check": "node scripts/generate-openapi-types.mjs --check",
    "build": "pnpm generate:check && tsc -p tsconfig.json",
    "typecheck": "pnpm generate:check && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm generate:check && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@marketingovo/contracts": "workspace:*",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@marketingovo/server": "workspace:*",
    "@types/node": "^24.3.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "private": false
}
