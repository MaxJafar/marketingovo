{
  "name": "@marketingovo/contracts",
  "version": "1.1.0",
  "description": "Runtime-validated public contracts for Marketingovo",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./project-bundle": {
      "types": "./dist/project-bundle.d.ts",
      "default": "./dist/project-bundle.js"
    },
    "./agent-tools": {
      "types": "./dist/agent-tools.d.ts",
      "default": "./dist/agent-tools.js"
    },
    "./channels": {
      "types": "./dist/channels.d.ts",
      "default": "./dist/channels.js"
    },
    "./publishing": {
      "types": "./dist/publishing.d.ts",
      "default": "./dist/publishing.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "default": "./dist/email.js"
    },
    "./reporting": {
      "types": "./dist/reporting.d.ts",
      "default": "./dist/reporting.js"
    },
    "./campaign-links": {
      "types": "./dist/campaign-links.d.ts",
      "default": "./dist/campaign-links.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  },
  "private": false
}
