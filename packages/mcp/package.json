{
  "name": "@agentseoapp/mcp",
  "version": "0.11.0-alpha.0",
  "description": "Bundled stdio MCP bridge for AGENTseo",
  "license": "Elastic-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agentseo-mcp": "./dist/stdio.js",
    "golem-seo-mcp": "./dist/golem-seo-stdio.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "node ../../scripts/npm-publication-disabled.mjs direct-package-publish"
  },
  "dependencies": {
    "@agentseoapp/contracts": "workspace:*",
    "@agentseoapp/sdk": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0-beta.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "private": true
}
