{
  "name": "@agentintel/mcp",
  "version": "1.0.0",
  "description": "MCP bridge for the local AGENTintel evidence engine",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./http": "./dist/http.js"
  },
  "bin": {
    "agentintel-mcp": "./dist/stdio.js",
    "agentintel-mcp-http": "./dist/http-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentintel/contracts": "workspace:*",
    "@agentintel/sdk": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0-beta.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
