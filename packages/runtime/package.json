{
  "name": "@agentseoapp/runtime",
  "version": "0.11.0-alpha.0",
  "description": "Local AGENTseo service composition and workflow runtime",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "node ../../scripts/npm-publication-disabled.mjs direct-package-publish"
  },
  "dependencies": {
    "@agentseoapp/application": "workspace:*",
    "@agentseoapp/contracts": "workspace:*",
    "@agentseoapp/core": "workspace:*",
    "@agentseoapp/credentials": "workspace:*",
    "@agentseoapp/integrations": "workspace:*",
    "@agentseoapp/storage-sqlite": "workspace:*",
    "@sinclair/typebox": "^0.34.41",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true
}
