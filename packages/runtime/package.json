{
  "name": "@marketingovo/runtime",
  "version": "1.1.0",
  "description": "Local Marketingovo service composition and workflow runtime",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@marketingovo/application": "workspace:*",
    "@marketingovo/contracts": "workspace:*",
    "@marketingovo/core": "workspace:*",
    "@marketingovo/credentials": "workspace:*",
    "@marketingovo/integrations": "workspace:*",
    "@marketingovo/storage-sqlite": "workspace:*",
    "@sinclair/typebox": "^0.34.41",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  },
  "private": false
}
