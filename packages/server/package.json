{
  "name": "@golem-seo/server",
  "version": "0.11.0-alpha.0",
  "description": "Authenticated loopback Fastify API for Golem SEO Community Edition",
  "license": "Elastic-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/generate-openapi.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.5.1",
    "@golem-seo/contracts": "workspace:*",
    "@golem-seo/credentials": "workspace:*",
    "@golem-seo/integrations": "workspace:*",
    "@golem-seo/runtime": "workspace:*",
    "@sinclair/typebox": "^0.34.41",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GolemWorkers/golem-seo.git",
    "directory": "packages/server"
  },
  "homepage": "https://golemworkers.com/seo",
  "bugs": {
    "url": "https://github.com/GolemWorkers/golem-seo/issues"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
