{
  "name": "@marketingovo/server",
  "version": "1.1.0",
  "description": "Authenticated loopback Fastify API for Marketingovo",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/generate-openapi.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.5.1",
    "@marketingovo/contracts": "workspace:*",
    "@marketingovo/credentials": "workspace:*",
    "@marketingovo/integrations": "workspace:*",
    "@marketingovo/runtime": "workspace:*",
    "@sinclair/typebox": "^0.34.41",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "private": false
}
