{
  "name": "@golem-seo/core",
  "version": "0.11.0-alpha.0",
  "private": false,
  "description": "Crawler, checks, rule engine and reporting primitives for Golem SEO Community Edition",
  "license": "Elastic-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./custom-rule-regex": {
      "types": "./dist/custom-rule-regex.d.ts",
      "default": "./dist/custom-rule-regex.js"
    }
  },
  "files": [
    "dist",
    "!dist/cli.js",
    "!dist/cli.js.map",
    "!dist/cli.d.ts",
    "!dist/cli.d.ts.map",
    "custom-rules.example.json",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@golem-seo/integrations": "workspace:*",
    "chrome-launcher": "^1.2.1",
    "google-trends-api": "^4.9.2",
    "lighthouse": "^13.3.0",
    "linkedom": "^0.18.5",
    "robots-parser": "^3.0.1",
    "undici": "^7.16.0"
  },
  "optionalDependencies": {
    "playwright": "1.61.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GolemWorkers/golem-seo.git",
    "directory": "packages/core"
  },
  "homepage": "https://golemworkers.com/seo",
  "bugs": {
    "url": "https://github.com/GolemWorkers/golem-seo/issues"
  },
  "keywords": [
    "seo",
    "crawler",
    "technical-seo",
    "local-first",
    "gsc",
    "ga4"
  ]
}
