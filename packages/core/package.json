{
  "name": "@agentseoapp/core",
  "version": "0.11.0-alpha.0",
  "private": true,
  "description": "Crawler, checks, rule engine and reporting primitives for AGENTseo",
  "license": "Elastic-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./custom-rule-regex": {
      "types": "./dist/custom-rule-regex.d.ts",
      "default": "./dist/custom-rule-regex.js"
    }
  },
  "files": [
    "dist",
    "!dist/cli.js",
    "!dist/cli.js.map",
    "!dist/cli.d.ts",
    "!dist/cli.d.ts.map",
    "custom-rules.example.json",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "node ../../scripts/npm-publication-disabled.mjs direct-package-publish"
  },
  "dependencies": {
    "@agentseoapp/integrations": "workspace:*",
    "chrome-launcher": "^1.2.1",
    "google-trends-api": "^4.9.2",
    "lighthouse": "^13.3.0",
    "linkedom": "^0.18.5",
    "robots-parser": "^3.0.1",
    "undici": "^7.16.0"
  },
  "optionalDependencies": {
    "playwright": "1.61.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "seo",
    "crawler",
    "technical-seo",
    "local-first",
    "gsc",
    "ga4"
  ]
}
