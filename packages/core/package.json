{
  "name": "@marketingovo/core",
  "version": "1.1.0",
  "private": false,
  "description": "Crawler, checks, rule engine and reporting primitives for Marketingovo",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./custom-rule-regex": {
      "types": "./dist/custom-rule-regex.d.ts",
      "default": "./dist/custom-rule-regex.js"
    }
  },
  "files": [
    "dist",
    "!dist/cli.js",
    "!dist/cli.js.map",
    "!dist/cli.d.ts",
    "!dist/cli.d.ts.map",
    "custom-rules.example.json",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@marketingovo/integrations": "workspace:*",
    "chrome-launcher": "^1.2.1",
    "google-trends-api": "^4.9.2",
    "lighthouse": "^13.4.1",
    "linkedom": "^0.18.13",
    "robots-parser": "^3.0.1",
    "undici": "^8.9.0"
  },
  "optionalDependencies": {
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "seo",
    "crawler",
    "technical-seo",
    "local-first",
    "gsc",
    "ga4"
  ]
}
