{
  "name": "@agentseoapp/openclaw",
  "version": "0.12.0-alpha.0",
  "description": "Official OpenClaw tool adapter for AGENTseo",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/validate.mjs",
    "prepublishOnly": "node ../../scripts/npm-publication-disabled.mjs direct-package-publish"
  },
  "dependencies": {
    "@agentseoapp/contracts": "workspace:*",
    "@agentseoapp/sdk": "workspace:*",
    "typebox": "1.1.39"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": "2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.5.17",
      "pluginSdkVersion": "2026.5.17"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "private": true
}
