{
  "id": "agentintel",
  "name": "AGENTintel",
  "description": "Evidence-backed competitive research through six safe workflow-level tools.",
  "version": "1.0.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "serverUrl": {
        "type": "string",
        "default": "http://127.0.0.1:7465",
        "description": "AGENTintel loopback API URL."
      },
      "tokenFile": {
        "type": "string",
        "description": "Path to the local service-token file."
      },
      "timeoutMs": {
        "type": "number",
        "minimum": 1000,
        "maximum": 120000,
        "default": 30000
      }
    }
  },
  "activation": { "onStartup": true },
  "contracts": {
    "tools": [
      "agentintel_research_start",
      "agentintel_compare_start",
      "agentintel_run_get",
      "agentintel_search",
      "agentintel_entity_get",
      "agentintel_monitoring_status"
    ]
  },
  "toolMetadata": {
    "agentintel_research_start": { "optional": true },
    "agentintel_compare_start": { "optional": true }
  }
}
