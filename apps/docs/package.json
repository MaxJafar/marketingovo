{
  "name": "@marketingovo/docs",
  "version": "1.1.0",
  "private": true,
  "description": "Product documentation for Marketingovo",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev site --host 127.0.0.1 --port 4320",
    "build": "vitepress build site --outDir dist",
    "preview": "vitepress preview site --outDir dist --host 127.0.0.1 --port 4320",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/validate.mjs",
    "prepublishOnly": "node ../../scripts/npm-publication-disabled.mjs direct-package-publish"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "search-insights": "^2.17.3",
    "typescript": "^5.9.2",
    "vite": "^8.2.0",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
