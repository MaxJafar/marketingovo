{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AGENTseo",
  "version": "0.11.0-alpha.0",
  "identifier": "com.golemworkers.agentseo",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:3210; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "GolemWorkers",
    "homepage": "https://golemworkers.com/seo",
    "copyright": "Copyright 2026 GolemWorkers",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "shortDescription": "Local-first SEO operations system",
    "longDescription": "Turn crawl, Search Console, GA4, performance and SERP evidence into verified SEO actions.",
    "externalBin": ["binaries/agentseo-node"],
    "resources": ["runtime/**/*"],
    "macOS": { "minimumSystemVersion": "13.0" },
    "windows": {
      "wix": {
        "language": "en-US",
        "fragmentPaths": ["./windows/fragments/background-startup.wxs"],
        "componentRefs": ["AgentSeoBackgroundStartup"]
      }
    },
    "linux": { "appimage": { "bundleMediaFramework": false } }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/GolemWorkers/agentseo/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" },
      "pubkey": "__AGENTSEO_UPDATER_PUBLIC_KEY__"
    }
  }
}
