# Test and editor artifacts
playwright-report/
test-results/
output/playwright/
.nyc_output/
.DS_Store
# macOS AppleDouble sidecars. A copy from a Mac onto a non-HFS filesystem
# leaves one of these beside every file, and vitest and the plugin validator
# both try to parse the ones shadowing a .ts or .md source.
._*
*.swp
*.swo
.idea/
.vscode/

# Legacy untracked local companion
dashboard-backend/
