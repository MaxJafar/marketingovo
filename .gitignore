# Dependencies and generated output
node_modules/
dist/
.turbo/
coverage/
*.tsbuildinfo

# Built dashboard copied into the CLI package by packages/cli/scripts/copy-dashboard.mjs.
# It is regenerated on every build and shipped from disk via the CLI's `files` list,
# so tracking it only produced content-hash churn and a stale bundle.
packages/cli/dashboard/

